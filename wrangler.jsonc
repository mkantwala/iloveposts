{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iloveposts",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},

	"vars": {
		// The Workers AI model that designs and repairs the card — any text-generation id from
		// `npx wrangler ai models list`; .dev.vars overrides it locally. A model with vision also
		// looks at the tweet's pictures. One Workers AI request is cut off after about five minutes,
		// so a fast model matters.
		//   @cf/zai-org/glm-4.7-flash       GLM flash — Workers Free plan
		//   @cf/zai-org/glm-5.3-flash       GLM 5.3 flash — vision, needs Workers Paid
		//   @cf/google/gemma-4-26b-a4b-it   Gemma 4 — vision, fast, Workers Free plan
		"AGENT_MODEL": "@cf/zai-org/glm-4.7-flash",
		// How the card is designed: "direct" — one request through the AI binding for the design
		// and one per repair (about 15–40k tokens a card) — or "agent", the opencode tool loop in the
		// sandbox (far more tokens; needs the CF_ACCOUNT_ID and CF_API_TOKEN secrets). With "direct",
		// the agent is the fallback when a request fails, if those secrets are set.
		"DESIGN_ENGINE": "direct",

		// Card creation quotas, enforced exactly by the Quota Durable Object (src/api/quota.ts).
		// The global one is the deployment's daily cost ceiling.
		"CARDS_PER_HOUR_PER_CALLER": "5",
		"CARDS_PER_DAY_PER_CALLER": "20",
		"CARDS_PER_DAY_GLOBAL": "200"
	},
	// Browser Rendering has no local simulation, so this binding talks to the real remote
	// resource even under `wrangler dev`. Used to render, measure and export every card
	// (src/card/qa.ts).
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},

	// Workers AI has no local simulation, so this also talks to the real service under
	// `wrangler dev`. The direct designer calls it (src/card/designer.ts).
	"ai": {
		"binding": "AI",
		"remote": true
	},

	// The build sandbox: one container per card job, destroyed when the job ends. max_instances is
	// how many cards can build at once; a job that finds none free retries its stage.
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 2
		}
	],

	// Burst limits per caller, counted per Cloudflare location. Periods can only be 10 or 60s.
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "TWEET_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "Sandbox",
				"name": "Sandbox"
			},
			{
				"class_name": "CardJob",
				"name": "CARD_JOBS"
			},
			{
				"class_name": "Quota",
				"name": "QUOTAS"
			}
		]
	},

	// Each new Durable Object class needs its own migration entry; earlier tags stay in place.
	"migrations": [
		{
			"new_sqlite_classes": [
				"Sandbox"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"TweetProject"
			],
			"tag": "v2"
		},
		{
			"renamed_classes": [
				{
					"from": "TweetProject",
					"to": "CardJob"
				}
			],
			"tag": "v3"
		},
		{
			"new_sqlite_classes": [
				"Quota"
			],
			"tag": "v4"
		}
	],

	// Exported cards (self-contained HTML and PNG), idempotency keys and cached font files. Job
	// state lives in each CardJob's own storage, quotas in the Quota objects.
	"kv_namespaces": [
		{
			// No "id": Wrangler creates the namespace on the first deploy and writes the id back
			// here. A copy of this repo deployed to another account must remove that id again.
			"binding": "CARD_CACHE"
		}
	]
}
